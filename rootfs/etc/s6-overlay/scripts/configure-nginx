#!/bin/bash
set -euo pipefail

fail() {
    echo "[nginx-config] $*" >&2
    exit 1
}

validate_port() {
    local value=$1
    [[ "$value" =~ ^[0-9]+$ ]] || return 1
    ((10#$value >= 1 && 10#$value <= 65535))
}

validate_path() {
    [[ "$1" =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ "$1" != *//* ]]
}

validate_service_path() {
    [[ "$1" =~ ^/([A-Za-z0-9_-][A-Za-z0-9._-]*)(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$ ]]
}

validate_service_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

normalize_upstream() {
    local value=$1
    local host="${value%:*}"
    local port="${value##*:}"

    [[ "$value" == *:* ]] \
        && [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] \
        && validate_port "$port" \
        || return 1
    printf '%s:%d\n' "$host" "$((10#$port))"
}

enabled="${NGINX_ENABLE:-true}"
case "$enabled" in
    true) ;;
    false)
        echo "[nginx-config] Disabled."
        exit 0
        ;;
    *) fail "NGINX_ENABLE must be true or false." ;;
esac

http_redirect="${NGINX_HTTP_REDIRECT:-true}"
case "$http_redirect" in
    true|false) ;;
    *) fail "NGINX_HTTP_REDIRECT must be true or false." ;;
esac

http_port="${NGINX_HTTP_PORT:-80}"
https_port="${NGINX_HTTPS_PORT:-443}"
validate_port "$http_port" || fail "NGINX_HTTP_PORT must be between 1 and 65535."
validate_port "$https_port" || fail "NGINX_HTTPS_PORT must be between 1 and 65535."
http_port=$((10#$http_port))
https_port=$((10#$https_port))
[ "$http_port" != "$https_port" ] || fail "NGINX_HTTP_PORT and NGINX_HTTPS_PORT must differ."

upstream="$(normalize_upstream "${NGINX_UPSTREAM:-127.0.0.1:8080}")" \
    || fail "NGINX_UPSTREAM must be a safe host:port value."

unified_auth="${NGINX_UNIFIED_AUTH:-true}"
case "$unified_auth" in
    true|false) ;;
    *) fail "NGINX_UNIFIED_AUTH must be true or false." ;;
esac
unified_auth_enabled=false
if [ "$unified_auth" = true ] && [ -n "${PASSWORD:-}" ]; then
    unified_auth_enabled=true
fi

portal_path=/services
status_path=/status
status_json_path=/status.json
dns_path=/dns
dns_api_path=/dns/api
manager_path=/manage
manager_api_path=/manage/api
manager_enabled="${MANAGER_ENABLE:-true}"
case "$manager_enabled" in
    true|false) ;;
    *) fail "MANAGER_ENABLE must be true or false." ;;
esac
if [ "$manager_enabled" = true ] && [ "$unified_auth_enabled" != true ]; then
    echo "[nginx-config] Certificate management disabled because unified authentication is unavailable."
    manager_enabled=false
fi
manager_port="${MANAGER_PORT:-8788}"
validate_port "$manager_port" || fail "MANAGER_PORT must be between 1 and 65535."
manager_port=$((10#$manager_port))
dns_web_enabled="${RESOLV_WEB_ENABLE:-true}"
case "$dns_web_enabled" in
    true|false) ;;
    *) fail "RESOLV_WEB_ENABLE must be true or false." ;;
esac
dns_allow_unauthenticated="${RESOLV_WEB_ALLOW_UNAUTHENTICATED:-false}"
case "$dns_allow_unauthenticated" in
    true|false) ;;
    *) fail "RESOLV_WEB_ALLOW_UNAUTHENTICATED must be true or false." ;;
esac
dns_password="${RESOLV_WEB_PASSWORD:-${PASSWORD:-}}"
if [ "$dns_web_enabled" = true ] \
    && [ "$unified_auth_enabled" != true ] \
    && [ -z "$dns_password" ] \
    && [ "$dns_allow_unauthenticated" != true ]; then
    echo "[nginx-config] DNS management disabled because no password is configured."
    dns_web_enabled=false
fi
dns_port="${RESOLV_WEB_PORT:-8787}"
validate_port "$dns_port" || fail "RESOLV_WEB_PORT must be between 1 and 65535."
dns_port=$((10#$dns_port))
service_links="${NGINX_SERVICE_LINKS:-}"
declare -a service_names=()
declare -a service_paths=()
declare -a service_upstreams=()

if [ -n "$service_links" ]; then
    [[ "$service_links" != \;* ]] \
        && [[ "$service_links" != *\; ]] \
        && [[ "$service_links" != *\;\;* ]] \
        || fail "NGINX_SERVICE_LINKS must be a semicolon-separated service list."
    IFS=';' read -r -a services <<<"$service_links"
    for service in "${services[@]}"; do
        IFS='|' read -r service_name service_path service_upstream extra <<<"$service"
        [ -n "${service_name:-}" ] \
            && [ -n "${service_path:-}" ] \
            && [ -n "${service_upstream:-}" ] \
            && [ -z "${extra:-}" ] \
            || fail "Each NGINX_SERVICE_LINKS entry must be name|/path|host:port."
        validate_service_name "$service_name" \
            || fail "Service names may only contain letters, numbers, dots, underscores, and hyphens."
        validate_service_path "$service_path" \
            || fail "Service paths must be an absolute path without a trailing slash."
        [ "$service_path" != "$portal_path" ] \
            && [ "$service_path" != "$status_path" ] \
            && [ "$service_path" != "$status_json_path" ] \
            && [ "$service_path" != "$dns_path" ] \
            && [[ "$service_path" != "$dns_path"/* ]] \
            && [ "$service_path" != "$manager_path" ] \
            && [[ "$service_path" != "$manager_path"/* ]] \
            || fail "Service path ${service_path} is reserved for a built-in endpoint."
        service_upstream="$(normalize_upstream "$service_upstream")" \
            || fail "Service ${service_name} must use a safe host:port upstream."

        for existing_name in "${service_names[@]}"; do
            [ "$service_name" != "$existing_name" ] \
                || fail "Service name ${service_name} is defined more than once."
        done
        for existing_path in "${service_paths[@]}"; do
            [ "$service_path" != "$existing_path" ] \
                || fail "Service path ${service_path} is defined more than once."
        done

        service_names+=("$service_name")
        service_paths+=("$service_path")
        service_upstreams+=("$service_upstream")
    done
fi

requested_names="${NGINX_SERVER_NAMES:-_}"
server_names=""
certificate_sans=""
certificate_cn=""
if [ "$requested_names" = "_" ]; then
    server_names="_"
    certificate_cn="localhost"
    certificate_sans="DNS:localhost,IP:127.0.0.1"
else
    [[ "$requested_names" != ,* ]] \
        && [[ "$requested_names" != *, ]] \
        && [[ "$requested_names" != *,,* ]] \
        || fail "NGINX_SERVER_NAMES must be a comma-separated domain list."
    IFS=',' read -r -a names <<<"$requested_names"
    for name in "${names[@]}"; do
        name="${name,,}"
        [[ "$name" =~ ^(\*\.)?[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$ ]] \
            || fail "Invalid domain in NGINX_SERVER_NAMES: $name"
        server_names+="${server_names:+ }${name}"
        certificate_sans+="${certificate_sans:+,}DNS:${name}"
        [ -n "$certificate_cn" ] || certificate_cn="$name"
    done
fi

runtime_dir=/run/nginx
config_file="${runtime_dir}/nginx.conf"
default_cert_dir="${runtime_dir}/default-certificate"
default_cert="${default_cert_dir}/tls.crt"
default_key="${default_cert_dir}/tls.key"
mounted_cert=/etc/nginx/certs/tls.crt
mounted_key=/etc/nginx/certs/tls.key
manager_config_dir="${MANAGER_CONFIG_DIR:-/opt/__container}"
uploaded_cert="${manager_config_dir}/tls/current/tls.crt"
uploaded_key="${manager_config_dir}/tls/current/tls.key"

cert_file=""
key_file=""
if [ -n "${NGINX_TLS_CERT_FILE+x}" ] || [ -n "${NGINX_TLS_KEY_FILE+x}" ]; then
    [ -n "${NGINX_TLS_CERT_FILE:-}" ] && [ -n "${NGINX_TLS_KEY_FILE:-}" ] \
        || fail "Set both NGINX_TLS_CERT_FILE and NGINX_TLS_KEY_FILE."
    cert_file="$NGINX_TLS_CERT_FILE"
    key_file="$NGINX_TLS_KEY_FILE"
elif [ -e "$mounted_cert" ] || [ -e "$mounted_key" ]; then
    cert_file="$mounted_cert"
    key_file="$mounted_key"
elif [ -e "$uploaded_cert" ] || [ -e "$uploaded_key" ]; then
    cert_file="$uploaded_cert"
    key_file="$uploaded_key"
else
    install -d -m 0755 "$runtime_dir"
    install -d -m 0700 "$default_cert_dir"
    umask 077
    openssl req -x509 -nodes -newkey rsa:2048 -sha256 -days 3650 \
        -keyout "$default_key" \
        -out "$default_cert" \
        -subj "/CN=${certificate_cn}" \
        -addext "subjectAltName=${certificate_sans}" \
        >/dev/null 2>&1 \
        || fail "Could not generate the default self-signed certificate."
    cert_file="$default_cert"
    key_file="$default_key"
    echo "[nginx-config] Generated a default self-signed certificate for ${certificate_cn}."
fi

validate_path "$cert_file" && validate_path "$key_file" \
    || fail "TLS certificate paths must be absolute safe paths."
[ -r "$cert_file" ] && [ -r "$key_file" ] \
    || fail "TLS certificate or key is not readable."
openssl x509 -in "$cert_file" -noout >/dev/null 2>&1 \
    || fail "NGINX_TLS_CERT_FILE is not a readable X.509 certificate."
openssl pkey -in "$key_file" -noout >/dev/null 2>&1 \
    || fail "NGINX_TLS_KEY_FILE is not a readable private key."

install -d -m 0755 "$runtime_dir"
portal_dir="${runtime_dir}/services"
portal_file="${portal_dir}/index.html"
status_dir="${runtime_dir}/status"
status_file="${status_dir}/status.json"
status_page="${status_dir}/index.html"
dns_dir="${runtime_dir}/dns"
dns_page="${dns_dir}/index.html"
manager_dir="${runtime_dir}/manage"
manager_page="${manager_dir}/index.html"
dns_auth_file="${runtime_dir}/resolver.htpasswd"
gateway_auth_file="${runtime_dir}/gateway.htpasswd"
install -d -m 0755 "$portal_dir"
install -d -m 0755 "$status_dir"
if [ "$unified_auth_enabled" = true ]; then
    gateway_password_hash="$(openssl passwd -apr1 "$PASSWORD")" \
        || fail "Could not generate the gateway password file."
    printf 'admin:%s\n' "$gateway_password_hash" >"$gateway_auth_file"
    chmod 0640 "$gateway_auth_file"
    chown root:www-data "$gateway_auth_file"
else
    rm -f "$gateway_auth_file"
fi
if [ "$dns_web_enabled" = true ]; then
    install -d -m 0755 "$dns_dir"
    install -m 0644 /usr/local/share/docker-image/resolver.html "$dns_page"
    if [ "$unified_auth_enabled" = true ]; then
        rm -f "$dns_auth_file"
    elif [ -n "$dns_password" ]; then
        dns_password_hash="$(openssl passwd -apr1 "$dns_password")" \
            || fail "Could not generate the DNS page password file."
        printf 'admin:%s\n' "$dns_password_hash" >"$dns_auth_file"
        chmod 0640 "$dns_auth_file"
        chown root:www-data "$dns_auth_file"
    else
        rm -f "$dns_auth_file"
    fi
fi
if [ "$manager_enabled" = true ]; then
    install -d -m 0755 "$manager_dir"
    install -m 0644 /usr/local/share/docker-image/manager.html "$manager_page"
fi
cat >"$portal_file" <<'EOF'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Internal services</title>
  <style>
    :root { color: #172324; background: #f4f6f2; font-family: system-ui, sans-serif; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
    main { width: min(100%, 720px); }
    .eyebrow { margin: 0 0 8px; color: #157a6e; font-size: 13px; font-weight: 700; text-transform: uppercase; }
    h1 { margin: 0 0 24px; font-size: 28px; font-weight: 700; }
    .services { display: grid; gap: 10px; }
    .service { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding: 16px; border: 1px solid #c9d5d1; border-radius: 8px; color: inherit; background: #ffffff; text-decoration: none; }
    .service:hover, .service:focus-visible { border-color: #157a6e; outline: 2px solid #157a6e; outline-offset: 2px; }
    .service strong { overflow-wrap: anywhere; }
    .service span { color: #51605d; font-family: ui-monospace, monospace; font-size: 13px; overflow-wrap: anywhere; text-align: right; }
    @media (max-width: 480px) { body { padding: 16px; } .service { align-items: flex-start; flex-direction: column; gap: 6px; } .service span { text-align: left; } }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">Gateway</p>
    <h1>Internal services</h1>
    <section class="services" aria-label="Internal services">
EOF
printf '      <a class="service" href="/"><strong>code-server</strong><span>/</span></a>\n' >>"$portal_file"
for service_index in "${!service_names[@]}"; do
    printf '      <a class="service" href="%s/"><strong>%s</strong><span>%s/</span></a>\n' \
        "${service_paths[$service_index]}" \
        "${service_names[$service_index]}" \
        "${service_paths[$service_index]}" \
        >>"$portal_file"
done
printf '      <a class="service service-secondary" href="/status/"><strong>Runtime status</strong><span>/status/</span></a>\n' >>"$portal_file"
if [ "$dns_web_enabled" = true ]; then
    printf '      <a class="service service-secondary" href="%s/"><strong>DNS settings</strong><span>%s/</span></a>\n' \
        "$dns_path" "$dns_path" >>"$portal_file"
fi
if [ "$manager_enabled" = true ]; then
    printf '      <a class="service service-secondary" href="%s/"><strong>Certificates</strong><span>%s/</span></a>\n' \
        "$manager_path" "$manager_path" >>"$portal_file"
fi
cat >>"$portal_file" <<'EOF'
    </section>
  </main>
</body>
</html>
EOF
chmod 0644 "$portal_file"

cat >"$status_page" <<'EOF'
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Runtime status</title>
  <style>
    :root { color: #172324; background: #edf2f0; font-family: system-ui, sans-serif; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; padding: 24px; }
    main { width: min(100%, 860px); margin: 0 auto; }
    header { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
    .eyebrow { margin: 0 0 8px; color: #157a6e; font-size: 13px; font-weight: 700; text-transform: uppercase; }
    h1, h2, p { margin-top: 0; }
    h1 { margin-bottom: 0; font-size: 30px; }
    h2 { margin-bottom: 0; font-size: 17px; }
    .back { color: #157a6e; font-weight: 700; text-decoration: none; }
    .back:hover, .back:focus-visible { text-decoration: underline; }
    .summary { margin-bottom: 18px; color: #51605d; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 18px; }
    .component, .panel { border: 1px solid #c9d5d1; border-radius: 8px; background: #ffffff; }
    .component { min-height: 82px; padding: 15px; }
    .component strong { display: block; margin-bottom: 10px; }
    .badge { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; text-transform: uppercase; }
    .badge::before { width: 8px; height: 8px; border-radius: 50%; background: #85918e; content: ''; }
    .badge-up { color: #16734e; }
    .badge-up::before { background: #1ca66f; }
    .badge-down { color: #b3473c; }
    .badge-down::before { background: #d45b4c; }
    .badge-disabled { color: #697572; }
    .panel { padding: 18px; }
    .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .updated { color: #697572; font-family: ui-monospace, monospace; font-size: 12px; }
    .routes { display: grid; gap: 8px; }
    .route { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 11px 12px; border: 1px solid #e0e7e4; border-radius: 6px; }
    .route-name { min-width: 0; overflow-wrap: anywhere; }
    .route-name strong { display: block; }
    .route-name span { color: #697572; font-family: ui-monospace, monospace; font-size: 12px; overflow-wrap: anywhere; }
    .empty { margin: 0; color: #697572; }
    @media (max-width: 520px) { body { padding: 16px; } header { align-items: flex-start; flex-direction: column; gap: 10px; } .route { align-items: flex-start; flex-direction: column; gap: 7px; } }
  </style>
</head>
<body>
  <main>
    <header>
      <div><p class="eyebrow">Runtime monitor</p><h1>Container status</h1></div>
      <a class="back" href="/services/">Back to services</a>
    </header>
    <p class="summary" id="summary">Loading runtime status...</p>
    <section class="grid" id="components" aria-label="Component status"></section>
    <section class="panel" aria-labelledby="routes-title">
      <div class="section-heading"><h2 id="routes-title">Service routes</h2><span class="updated" id="updated"></span></div>
      <div class="routes" id="services"></div>
    </section>
  </main>
  <script>
    const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    const stateLabel = (state) => state === 'up' ? 'online' : state === 'down' ? 'offline' : state;
    const stateClass = (state) => state === 'up' ? 'badge-up' : state === 'down' ? 'badge-down' : 'badge-disabled';
    const componentLabels = { ssh: 'SSH', code_server: 'code-server', nginx: 'Nginx', dockerd: 'Rootless DIND', tailscale: 'Tailscale' };

    function render(data) {
      const components = Object.entries(data.components || {});
      document.getElementById('components').innerHTML = components.map(([key, state]) => `
        <article class="component"><strong>${escapeHtml(componentLabels[key] || key)}</strong><span class="badge ${stateClass(state)}">${escapeHtml(stateLabel(state))}</span></article>
      `).join('');
      const usage = data.workspace_usage || 'unknown';
      const mounts = Number.isFinite(Number(data.sshfs_mounts)) ? data.sshfs_mounts : 0;
      document.getElementById('summary').textContent = `Workspace usage ${usage} · SSHFS mounts ${mounts}`;
      document.getElementById('updated').textContent = data.generated_at ? `updated ${new Date(data.generated_at).toLocaleTimeString()}` : 'starting';
      const services = data.services || [];
      document.getElementById('services').innerHTML = services.length ? services.map((service) => `
        <div class="route"><div class="route-name"><strong>${escapeHtml(service.name)}</strong><span>${escapeHtml(service.path)} · ${escapeHtml(service.endpoint)}</span></div><span class="badge ${stateClass(service.state)}">${escapeHtml(stateLabel(service.state))}</span></div>
      `).join('') : '<p class="empty">No service routes configured.</p>';
    }

    async function refresh() {
      try {
        const response = await fetch(`/status.json?ts=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        render(await response.json());
      } catch (error) {
        document.getElementById('summary').textContent = `Status unavailable: ${error.message}`;
      }
    }

    refresh();
    setInterval(refresh, 5000);
  </script>
</body>
</html>
EOF
install -m 0644 /usr/local/share/docker-image/status.html "$status_page"
if [ ! -s "$status_file" ] || ! jq -e . "$status_file" >/dev/null 2>&1; then
    cat >"$status_file" <<'EOF'
{"generated_at":null,"hostname":"unknown","uptime_seconds":0,"workspace_usage":"unknown","memory_used_bytes":0,"memory_total_bytes":0,"memory_usage_percent":0,"load_average":["0","0","0"],"sshfs_mounts":0,"components":{},"services":[]}
EOF
fi
chmod 0644 "$status_page" "$status_file"

write_dns_auth() {
    if [ -s "$dns_auth_file" ]; then
        cat >>"$config_file" <<EOF
            auth_basic "DNS settings";
            auth_basic_user_file ${dns_auth_file};
EOF
    fi
}

write_gateway_auth() {
    if [ "$unified_auth_enabled" = true ]; then
        cat >>"$config_file" <<EOF
        auth_basic "Docker image";
        auth_basic_user_file ${gateway_auth_file};
EOF
    fi
}

write_service_locations() {
    local protocol=$1
    local service_index
    local service_path
    local service_upstream

    cat >>"$config_file" <<EOF
        location = ${portal_path} {
            return 308 ${portal_path}/;
        }

        location = ${portal_path}/ {
            root ${runtime_dir};
            try_files ${portal_path}/index.html =404;
            default_type text/html;
            add_header Cache-Control "no-store";
        }

        location = ${status_path} {
            return 308 ${status_path}/;
        }

        location = ${status_path}/ {
            root ${runtime_dir};
            try_files ${status_path}/index.html =404;
            default_type text/html;
            add_header Cache-Control "no-store";
        }

        location = ${status_json_path} {
            root ${runtime_dir};
            try_files ${status_path}/status.json =404;
            default_type application/json;
            add_header Cache-Control "no-store";
        }
EOF

    if [ "$dns_web_enabled" = true ]; then
        cat >>"$config_file" <<EOF
        location = ${dns_path} {
            return 308 ${dns_path}/;
        }

        location = ${dns_api_path} {
            return 308 ${dns_api_path}/;
        }

        location = ${dns_path}/ {
            root ${runtime_dir};
            try_files ${dns_path}/index.html =404;
            default_type text/html;
            add_header Cache-Control "no-store";
EOF
        write_dns_auth
        cat >>"$config_file" <<EOF
        }

        location ^~ ${dns_api_path}/ {
            proxy_pass http://127.0.0.1:${dns_port}/api/;
            proxy_http_version 1.1;
            proxy_set_header Host \$host;
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto \$scheme;
            proxy_buffering off;
            proxy_read_timeout 20s;
            proxy_send_timeout 20s;
EOF
        write_dns_auth
        cat >>"$config_file" <<EOF
        }
EOF
    fi

    if [ "$manager_enabled" = true ]; then
        cat >>"$config_file" <<EOF
        location = ${manager_path} {
            return 308 ${manager_path}/;
        }

        location = ${manager_api_path} {
            return 308 ${manager_api_path}/;
        }

        location = ${manager_path}/ {
            root ${runtime_dir};
            try_files ${manager_path}/index.html =404;
            default_type text/html;
            add_header Cache-Control "no-store";
        }

        location ^~ ${manager_api_path}/ {
            proxy_pass http://127.0.0.1:${manager_port}/api/;
            proxy_http_version 1.1;
            proxy_set_header Host \$http_host;
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto \$scheme;
            proxy_request_buffering off;
            client_max_body_size 5m;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
        }
EOF
    fi

    for service_index in "${!service_paths[@]}"; do
        service_path="${service_paths[$service_index]}"
        service_upstream="${service_upstreams[$service_index]}"
        cat >>"$config_file" <<EOF
        location = ${service_path} {
            return 308 ${service_path}/;
        }

        location ^~ ${service_path}/ {
            proxy_pass http://${service_upstream}/;
            proxy_http_version 1.1;
            proxy_set_header Host \$host;
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host \$host;
            proxy_set_header X-Forwarded-Proto ${protocol};
            proxy_set_header X-Forwarded-Prefix ${service_path};
            proxy_set_header Upgrade \$http_upgrade;
            proxy_set_header Connection \$connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
EOF
    done
}

write_default_proxy_location() {
    local protocol=$1

    cat >>"$config_file" <<EOF
        location = /healthz {
            auth_basic off;
            proxy_pass http://${upstream}/healthz;
            proxy_http_version 1.1;
            proxy_set_header Host \$host;
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto ${protocol};
        }

        location / {
            proxy_pass http://${upstream};
            proxy_http_version 1.1;
            proxy_set_header Host \$host;
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host \$host;
            proxy_set_header X-Forwarded-Proto ${protocol};
            proxy_set_header Upgrade \$http_upgrade;
            proxy_set_header Connection \$connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
EOF
}

redirect_authority='$host'
if [ "$https_port" != 443 ]; then
    redirect_authority="\$host:${https_port}"
fi

cat >"$config_file" <<EOF
user www-data;
worker_processes auto;
pid /run/nginx/nginx.pid;
error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 0;

    map \$http_upgrade \$connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen ${http_port};
        server_name ${server_names};
EOF

if [ "$http_redirect" = "true" ]; then
    printf '        return 308 https://%s$request_uri;\n' "$redirect_authority" >>"$config_file"
else
    write_gateway_auth
    write_service_locations http
    write_default_proxy_location http
fi

cat >>"$config_file" <<EOF
    }

    server {
        listen ${https_port} ssl;
        http2 on;
        server_name ${server_names};

        ssl_certificate ${cert_file};
        ssl_certificate_key ${key_file};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
EOF

write_gateway_auth
write_service_locations https
write_default_proxy_location https

cat >>"$config_file" <<EOF
    }
}
EOF

/usr/sbin/nginx -t -q -c "$config_file" \
    || fail "Generated Nginx configuration is invalid."
echo "[nginx-config] HTTPS entrypoint configured for ${server_names}; upstream=${upstream}; status=${status_path}/."
