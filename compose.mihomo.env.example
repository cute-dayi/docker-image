# Docker Compose project and images
COMPOSE_PROJECT_NAME=ovo-mihomo
MIHOMO_IMAGE=proxy-docker-hub.lty520.faith/metacubex/mihomo:latest
OVO_IMAGE=ghcr.io/rabbit-dayi/docker-image:latest

# Container names
MIHOMO_CONTAINER_NAME=mihomo-px-2-898989
OVO_CONTAINER_NAME=ovo_bo2_0_1_128

# Host paths
MIHOMO_CONFIG_DIR=./container_data/mihomo
OVO_STATE_DIR=./container_data/ovo/state
OVO_WORKSPACE_DIR=./container_data/ovo/workspace
HF_DATA_DIR=./container_data/hf_data

# Published ports
MIHOMO_PROXY_BIND_IP=127.0.0.1
MIHOMO_PROXY_PORT=47891
MIHOMO_CONTROLLER_BIND_IP=127.0.0.1
MIHOMO_CONTROLLER_PORT=49092
OVO_BIND_IP=0.0.0.0
OVO_SSH_PORT=49123
OVO_HTTP_PORT=49183
OVO_HTTPS_PORT=49184

# ovo login and routes
GITHUB_USER=rabbit-dayi
OVO_PASSWORD=
OVO_DOMAIN=_
OVO_SERVICE_LINKS="Mihomo|/mihomo|127.0.0.1:9090"
DAYI_FLAG=

# DNS behavior in the shared Mihomo network namespace
RESOLV_LOCAL_NAMESERVER=127.0.0.1
RESOLV_FALLBACK_NAMESERVER=1.1.1.1
RESOLV_FALLBACK_ALWAYS=false
RESOLV_CHECK_DOMAIN=example.com

# Tailscale. Leave TS_AUTHKEY empty to authenticate manually or reuse persisted state.
TS_ENABLE=true
TS_AUTHKEY=
TS_HOSTNAME=ovo-bo2-0-1
TS_ADVERTISE_TAGS=

# NVIDIA and shared memory
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
OVO_SHM_SIZE=64gb
TZ=Asia/Shanghai
